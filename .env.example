# Use the lowercase GitHub owner/repository shown in the Actions build summary.
FINREG_IMAGE=ghcr.io/your-account/finreg-practice:latest

# Bind localhost when using a reverse proxy on this server.
FINREG_BIND_ADDRESS=127.0.0.1
FINREG_PORT=8765
FINREG_ALLOWED_ORIGINS=https://study.example.com

# This directory holds SQLite, images and original PDFs across upgrades.
FINREG_DATA_DIR=./data
FINREG_UID=1000
FINREG_GID=1000
